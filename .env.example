# Ganti dengan nama unik kelompokmu (huruf, angka, - dan _)
PROJECT_ID=sealguard_kelompok_04

# Broker publik HiveMQ: tanpa akun
MQTT_HOST=broker.hivemq.com
MQTT_PORT=8883
MQTT_TLS=true

# Model Decision Tree (dibuat oleh train_tree.py). Kalau file ini tidak ada, detector memakai threshold.
# MODEL_PATH=models/model.json

# Ambang threshold (tebakan awal: kalibrasi dari data ujimu sendiri)
# WINDOW_S=1.0
# IMPACT_COUNT_G=2.0
# BENTURAN_G=2.0
# RUSAK_G=5.0
# RUSAK_COUNT=3
# RUSAK_COUNT_G=3.0
FUSION_WINDOW_S=5

# Cahaya: dari rekaman percobaan kelompok 4, kardus tertutup = 0 lux, terbuka = 10-14 lux.
# Bawaan 20 terlalu tinggi, jadi dipakai 5. Ukur ulang di perangkatmu.
LUX_OPEN=5
